<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= status || 'Error' %> — FREE6</title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
  <nav class="navbar">
    <div class="nav-inner">
      <a class="brand" href="/">FREE6</a>
    </div>
  </nav>

  <main class="container error-page">
    <div class="error-code"><%= status || 500 %></div>
    <h1><%= message || 'Something went wrong' %></h1>
    <p class="muted">
      <% if (status === 404) { %>
        The page you're looking for doesn't exist.
      <% } else { %>
        An unexpected error occurred. Please try again later.
      <% } %>
    </p>
    <a href="/" class="btn btn-primary">Go Home</a>
  </main>

  <footer class="footer">
    <p>© 2026 jasonzli-DEV · <a href="https://github.com/jasonzli-DEV/FREE6">GitHub</a></p>
  </footer>
</body>
</html>
