# ================================================
# FREE6 — Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Discord bot token (https://discord.com/developers/applications → Bot → Token)
BOT_TOKEN=

# Discord application client ID
CLIENT_ID=

# Discord OAuth2 client secret (Developer Portal → OAuth2)
CLIENT_SECRET=

# OAuth2 redirect URI (must match Developer Portal → OAuth2 → Redirects)
REDIRECT_URI=http://localhost:3000/auth/callback

# Dashboard port
DASHBOARD_PORT=3000

# Public URL of the dashboard
DASHBOARD_URL=http://localhost:3000

# Session secret for the web dashboard (auto-generated if left blank, but sessions
# will be invalidated on every restart — set a fixed random string for persistence)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# YouTube Data API v3 key (https://console.cloud.google.com/)
YOUTUBE_API_KEY=
