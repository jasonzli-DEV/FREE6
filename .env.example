# ================================================
# FREE6 — Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# ── Discord Bot ────────────────────────────────
# Your bot's token from https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here

# Your bot's application/client ID
CLIENT_ID=your_client_id_here

# Guild ID to deploy slash commands to during development (leave blank for global)
DEV_GUILD_ID=your_dev_guild_id_here

# Bot owner's Discord user ID (for owner-only commands)
OWNER_ID=your_discord_user_id_here

# ── Web Dashboard ──────────────────────────────
# Port the dashboard runs on
DASHBOARD_PORT=3000

# Secret used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change_this_to_a_random_secret_string

# Public URL of your dashboard (used for OAuth2 redirect)
DASHBOARD_URL=http://localhost:3000

# ── Discord OAuth2 (for dashboard login) ───────
# From your Discord application's OAuth2 page
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Database ───────────────────────────────────
# Path to SQLite database file
DB_PATH=./data/free6.sqlite

# ── Bot Personalizer (Custom Bot) ─────────────
# Optional: Allows server owners to use their own bot token
# Leave blank to use the main bot token
CUSTOM_BOT_TOKEN=

# ── Logging ────────────────────────────────────
# Log level: error | warn | info | debug
LOG_LEVEL=info

# ── Social Alerts ──────────────────────────────
# Twitch API credentials (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=your_random_eventsub_secret

# YouTube Data API v3 key (https://console.cloud.google.com/)
YOUTUBE_API_KEY=

# ── Anti-Raid ──────────────────────────────────
# Notify this channel ID when raid is detected (optional)
ANTI_RAID_ALERT_CHANNEL=

# ── Economy ────────────────────────────────────
# Default daily coin amount
DEFAULT_DAILY_COINS=100

# ── Giveaways ──────────────────────────────────
# Emoji used for giveaway entries
GIVEAWAY_EMOJI=🎉
